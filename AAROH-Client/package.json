{
  "name": "agropulse",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:lan": "expo start --dev-client --lan --clear",
    "start:go": "expo start",
    "start:device": "powershell -ExecutionPolicy Bypass -File scripts/start-device.ps1",
    "start:emulator": "powershell -ExecutionPolicy Bypass -File scripts/start-emulator.ps1",
    "start:phone": "powershell -ExecutionPolicy Bypass -File scripts/start-phone.ps1",
    "phone": "npm run start:phone",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:frames": "node --experimental-strip-types scripts/verify-frames.mjs",
    "mock:frames": "node scripts/make-mock-walk.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "~19.2.4",
    "base64-js": "^1.5.1",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19"
  }
}
